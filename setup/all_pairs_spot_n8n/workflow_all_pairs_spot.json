      "id": "code_filter_symbols",
      "name": "Filter USDT Spot Symbols",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 130],
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Input 0: exchangeInfo, input 1: ticker24hr\nconst exchangeInfo = $input.all(0, 0)[0]?.json;\nconst tickers = $input.all(1, 0).map(i => i.json);\nif (!exchangeInfo?.symbols) throw new Error('Missing exchangeInfo.symbols');\nconst quoteVolumeBySymbol = Object.fromEntries(tickers.map(t => [t.symbol, Number(t.quoteVolume || 0)]));\nconst out = [];\nfor (const s of exchangeInfo.symbols) {\n  if (s.status !== 'TRADING') continue;\n  if (s.isSpotTradingAllowed !== true) continue;\n  if (s.quoteAsset !== 'USDT') continue;\n  if (String(s.symbol).includes('UPUSDT') || String(s.symbol).includes('DOWNUSDT')) continue;\n  const vol = quoteVolumeBySymbol[s.symbol] ?? 0;\n  if (vol < 5_000_000) continue;\n  out.push({ json: { symbol: s.symbol } });\n}\nreturn out;"
      }
    },
